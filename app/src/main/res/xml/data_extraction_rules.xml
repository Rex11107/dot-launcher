<?xml version="1.0" encoding="utf-8"?>
<!-- Backup nel cloud e trasferimento a un nuovo telefono (Android 12+): niente chiavi API -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secret.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secret.xml" />
    </device-transfer>
</data-extraction-rules>
